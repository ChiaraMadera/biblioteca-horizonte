						"method": "GET",
						"url": {
							"raw": "{{base_url}}/api/users/?role=docente&status=ACTIVO&search=juan&page=1&limit=10",
							"host": ["{{base_url}}"],
							"path": ["api", "users", ""],
							"query": [
								{ "key": "role", "value": "docente" },
								{ "key": "status", "value": "ACTIVO" },
