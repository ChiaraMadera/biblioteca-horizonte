{
	"info": {
		"name": "Biblioteca Horizonte - Backend API",
		"description": "Colección Postman generada a partir del análisis del código en app/routes/ (auth, users, resources, requests, admin) y app/schemas/. Base URL por defecto: http://127.0.0.1:5000 (run.py). Flujo sugerido: 1) Login con los 3 roles (los tests guardan los tokens en variables), 2) probar Resources/Requests, 3) Admin.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "base_url", "value": "http://127.0.0.1:5000", "type": "string" },
		{ "key": "token_admin", "value": "", "type": "string" },
		{ "key": "token_biblio", "value": "", "type": "string" },
		{ "key": "token_docente", "value": "", "type": "string" },
		{ "key": "resource_id", "value": "proyector-01", "type": "string" },
		{ "key": "request_id", "value": "BH-XXXX", "type": "string" },
		{ "key": "user_id", "value": "REEMPLAZAR_USER_ID", "type": "string" }
	],
	"auth": {
		"type": "bearer",
		"bearertoken": [{ "key": "token", "value": "{{token_docente}}", "type": "string" }]
	},
	"item": [
		{
			"name": "00 - Auth",
			"item": [
				{
					"name": "Login - Admin",
					"request": {
						"method": "POST",
						"url": "{{base_url}}/api/auth/login",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@horizonte.edu.ar\",\n  \"password\": \"Admin123!\"\n}"
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var json = pm.response.json();",
									"if (json.token) { pm.collectionVariables.set('token_admin', json.token); }"
								]
							}
						}
					]
				},
				{
					"name": "Login - Bibliotecaria",
					"request": {
						"method": "POST",
						"url": "{{base_url}}/api/auth/login",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"biblioteca@horizonte.edu.ar\",\n  \"password\": \"Biblioteca123!\"\n}"
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var json = pm.response.json();",
									"if (json.token) { pm.collectionVariables.set('token_biblio', json.token); }"
								]
							}
						}
					]
				},
				{
					"name": "Login - Docente 1",
					"request": {
						"method": "POST",
						"url": "{{base_url}}/api/auth/login",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"docente1@horizonte.edu.ar\",\n  \"password\": \"Docente123!\"\n}"
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var json = pm.response.json();",
									"if (json.token) { pm.collectionVariables.set('token_docente', json.token); }"
								]
							}
						}
					]
				},
				{
					"name": "Login - Docente 2",
					"request": {
						"method": "POST",
						"url": "{{base_url}}/api/auth/login",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"docente2@horizonte.edu.ar\",\n  \"password\": \"Docente123!\"\n}"
						}
					}
				},
				{
					"name": "Get Perfil - me (docente)",
					"request": {
						"method": "GET",
						"url": "{{base_url}}/api/auth/me",
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{token_docente}}", "type": "string" }]
						}
					}
				},
				{
					"name": "Get Perfil - me (admin)",
					"request": {
						"method": "GET",
						"url": "{{base_url}}/api/auth/me",
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{token_admin}}", "type": "string" }]
						}
					}
				}
			]
		},
		{
			"name": "01 - Users (admin, bibliotecaria)",
			"item": [
				{
