						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Docente Prueba\",\n  \"email\": \"docente.prueba@horizonte.edu.ar\",\n  \"password\": \"Docente123!\",\n  \"role\": \"docente\",\n  \"dni\": \"30123456\",\n  \"phone\": \"351-1234567\"\n}"
						}
					}
				},
				{
					"name": "Actualizar usuario (solo admin)",
					"request": {
						"method": "PUT",
						"url": "{{base_url}}/api/users/{{user_id}}",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{token_admin}}", "type": "string" }]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Docente Prueba Actualizado\",\n  \"phone\": \"351-7654321\",\n  \"status\": \"ACTIVO\"\n}"
						}
