							"raw": "{{base_url}}/api/users/?page=1&limit=10",
							"host": ["{{base_url}}"],
							"path": ["api", "users", ""],
							"query": [
								{ "key": "page", "value": "1" },
								{ "key": "limit", "value": "10" }
							]
						},
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{token_admin}}", "type": "string" }]
						}
					}
				},
